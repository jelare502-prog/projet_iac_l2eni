$TTL    604800
@       IN      SOA     ns1.{{ domain_name }}. admin.{{ domain_name }}. (
                  2026100501   ; Serial
                  604800       ; Refresh
                  86400        ; Retry
                  2419200      ; Expire
                  604800 )     ; Negative Cache TTL

; Serveurs DNS
@       IN      NS      ns1.{{ domain_name }}.
@       IN      A       127.0.0.1
ns1     IN      A       127.0.0.1

; Sous-domaines
appli       IN      A       127.0.0.1
webmail     IN      A       127.0.0.1
monitoring  IN      A       127.0.0.1
